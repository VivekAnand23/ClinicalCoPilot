{
  "name": "clinicalcopilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered blood work analysis and chronic disease risk detection",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node --watch server.js",
    "dev:frontend": "cd frontend && npx vite",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npx vitest run",
    "test:frontend": "cd frontend && npx vitest run",
    "test:e2e": "cd frontend && npx playwright test",
    "test:watch": "cd backend && vitest",
    "build": "cd frontend && vite build",
    "lint": "eslint . --ext .js,.jsx"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
